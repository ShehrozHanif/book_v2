{
  "title": "Chapter Entity Schema",
  "description": "JSON schema for a textbook chapter entity used in writing, review, and RAG indexing workflows",
  "type": "object",
  "required": [
    "id",
    "number",
    "module_id",
    "title",
    "file_path",
    "target_word_count",
    "learning_objectives",
    "status",
    "created_date"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^chapter_([0-2][0-9])$",
      "description": "Unique chapter identifier (chapter_01 to chapter_22)"
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 22,
      "description": "Sequential chapter number within textbook"
    },
    "module_id": {
      "type": "string",
      "pattern": "^module_[0-4]$",
      "description": "Parent module identifier (module_01 to module_04)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "description": "Chapter title"
    },
    "file_path": {
      "type": "string",
      "pattern": "^textbook/chapters/[0-9]{2}-.*\\.md$",
      "description": "Markdown file location relative to repo root"
    },
    "word_count": {
      "type": "integer",
      "minimum": 1000,
      "description": "Actual word count (filled during writing)"
    },
    "target_word_count": {
      "type": "integer",
      "enum": [2300, 2400],
      "description": "Target word count (2300-2400 per specification)"
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 200
      },
      "description": "Learning outcomes for the chapter"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "word_count"],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "subsections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "word_count": {
            "type": "integer",
            "minimum": 100
          }
        }
      },
      "description": "Chapter outline with section structure"
    },
    "code_examples": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^chapter_[0-2][0-9]_example_[0-9]{2}$"
      },
      "description": "List of code example IDs referenced in chapter"
    },
    "references": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^ref_[0-9]{3}$"
      },
      "description": "List of reference IDs cited in chapter"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "written", "review", "approved", "indexed"],
      "description": "Chapter workflow status"
    },
    "accuracy_score": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Expert review accuracy score (null before review)"
    },
    "review_status": {
      "type": "string",
      "enum": ["pending", "expert_review", "peer_review", "approved", "flagged"],
      "description": "Review workflow status"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "reviewed_date": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 review completion timestamp"
    },
    "indexed_date": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 RAG indexing timestamp"
    },
    "reviewer_notes": {
      "type": "string",
      "maxLength": 5000,
      "description": "Feedback from expert/peer reviewer"
    }
  }
}
