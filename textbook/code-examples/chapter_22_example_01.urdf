<?xml version="1.0"?>
<!--
  Chapter 22, Example 1: Walker-Bot URDF Model
  
  Complete 6-DOF bipedal robot for getting started with humanoid robotics.
  
  Structure:
  - Torso (base link) 
  - 2 legs, 3 DOF each (hip roll, hip pitch, knee pitch)
  - Fixed feet
  
  Features:
  - Realistic masses/inertias calculated from geometry
  - Joint limits based on human biomechanics
  - Gazebo integration with IMU sensor
  - ROS 2 control interfaces
  
  Usage:
    ros2 launch walker_bot_description spawn_walker.launch.py
  
  Author: Physical AI & Humanoid Robotics Textbook
-->
<robot name="walker_bot">

  <material name="blue"><color rgba="0.2 0.3 0.8 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <!-- TORSO -->
  <link name="torso">
    <visual>
      <geometry><box size="0.3 0.2 0.4"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.4"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.088" ixy="0" ixz="0" iyy="0.113" iyz="0" izz="0.046"/>
    </inertial>
  </link>

  <!-- RIGHT LEG -->
  <joint name="right_hip_roll" type="revolute">
    <parent link="torso"/>
    <child link="right_thigh"/>
    <origin xyz="0 -0.1 -0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="0.3" effort="50" velocity="2.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="right_thigh">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.3"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.3"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="right_hip_pitch" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shank"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.0" effort="50" velocity="2.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="right_shank">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.3"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.3"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0032" ixy="0" ixz="0" iyy="0.0032" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="right_knee_pitch" type="revolute">
    <parent link="right_shank"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="0" effort="40" velocity="2.5"/>
    <dynamics damping="0.8" friction="0.1"/>
  </joint>

  <link name="right_foot">
    <visual>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.15 0.08 0.02"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.15 0.08 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- LEFT LEG (mirror of right) -->
  <joint name="left_hip_roll" type="revolute">
    <parent link="torso"/>
    <child link="left_thigh"/>
    <origin xyz="0 0.1 -0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="0.3" effort="50" velocity="2.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="left_thigh">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.3"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.3"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="left_hip_pitch" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shank"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.0" effort="50" velocity="2.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="left_shank">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.3"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.3"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0032" ixy="0" ixz="0" iyy="0.0032" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="left_knee_pitch" type="revolute">
    <parent link="left_shank"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="0" effort="40" velocity="2.5"/>
    <dynamics damping="0.8" friction="0.1"/>
  </joint>

  <link name="left_foot">
    <visual>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.15 0.08 0.02"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.15 0.08 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 -0.01" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

</robot>
