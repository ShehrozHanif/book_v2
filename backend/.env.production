# PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================
# To be deployed to Render dashboard

# Database Configuration (Neon PostgreSQL)
# Format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://[USER]:[PASSWORD]@[NEON_HOST]/[DBNAME]?sslmode=require

# OpenAI Configuration
OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]
OPENAI_MODEL=gpt-3.5-turbo

# Qdrant Vector Database Configuration
QDRANT_URL=https://48c12265-788f-452b-a69f-eb32a7119dc4.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6NjVmY2ZlZjgtY2RhYy00MWU4LWIzNjEtMGVlMjQ2OWQxNmZkIn0.JQ6jN1jh1OHkweWhPeLmiiTONzlLkjhn6chQgU0HbRE
QDRANT_COLLECTION_NAME=textbook_chunks

# Server Configuration
HOST=0.0.0.0
PORT=10000
DEBUG=false
ENVIRONMENT=production

# CORS Configuration - UPDATE WITH YOUR GITHUB PAGES URL
ALLOWED_ORIGINS=["https://[YOUR_GITHUB_USERNAME].github.io", "https://[YOUR_GITHUB_USERNAME].github.io/book"]

# Rate Limiting (requests per period)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=60

# Query Configuration
MAX_QUERY_LENGTH=5000
MIN_QUERY_LENGTH=1

# RAG Configuration
TOP_K_RETRIEVAL=5
RELEVANCE_THRESHOLD=0.5

# Session Configuration
SESSION_TIMEOUT_HOURS=24

# Authentication & Personalization Configuration
# IMPORTANT: Generate a new random secret key (min 32 characters)
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=[GENERATE_NEW_SECRET_KEY_MIN_32_CHARS]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=100
