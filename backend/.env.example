# Database Configuration
# Use postgresql+asyncpg:// for async SQLAlchemy
# Local: postgresql+asyncpg://user:password@localhost:5432/rag_chatbot
# Production (Neon): postgresql+asyncpg://user:password@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rag_chatbot

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-api-key-here
QDRANT_COLLECTION_NAME=textbook_chunks

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=development

# CORS Configuration (comma-separated origins for .env)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=60

# Query Configuration
MAX_QUERY_LENGTH=5000
MIN_QUERY_LENGTH=1

# RAG Configuration
TOP_K_RETRIEVAL=5
RELEVANCE_THRESHOLD=0.5

# Session Configuration
SESSION_TIMEOUT_HOURS=24

# Authentication & Personalization Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=100
