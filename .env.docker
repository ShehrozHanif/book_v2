# Docker Compose Configuration for Personalization System

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DB_USER=personalization
DB_PASSWORD=personalization_secure_password
DB_NAME=personalization_db
DB_PORT=5432

# API Configuration
API_PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# OpenAI Integration
OPENAI_API_KEY=your-openai-api-key-here

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redis Cache
REDIS_PORT=6379
CACHE_TTL_SECONDS=3600

# Deployment Options
DATABASE_POOL_MODE=queuepool
